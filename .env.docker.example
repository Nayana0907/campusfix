# ==============================================================================
# CampusFix — Docker Compose Environment Template (.env.docker.example)
# Copy this file to .env before running: docker compose up -d
# ==============================================================================

# MySQL Database Credentials
DB_NAME=campusfix
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Whitelist (Include your domain or server IP)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# Frontend API Base URL (Leave blank to use Nginx reverse proxy /api/)
VITE_API_BASE_URL=
