# CampusFix Frontend Environment Configuration

# Local Development (or leave to .env.development default):
# VITE_API_BASE_URL=http://localhost:8080

# Production Deployment (e.g. Vercel dashboard -> Settings -> Environment Variables):
# Set this to your deployed Spring Boot backend URL without trailing slashes.
# Examples:
#   VITE_API_BASE_URL=https://campusfix-backend.onrender.com
#   VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=
