# ==============================================================================
# CampusFix Backend — Environment Variables Template (.env.example)
# Copy this file to .env and configure your values.
# NEVER commit production secrets or real credentials to source control.
# ==============================================================================

# Active Spring Profile (set to 'prod' in production on Render/Railway)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render/Railway automatically provides PORT)
PORT=8080

# Database Configuration (Supports standard JDBC or Cloud mysql:// URL)
# Option A: Cloud DATABASE_URL (Render / Railway / Supabase MySQL):
# DATABASE_URL=mysql://user:password@host:3306/campusfix
#
# Option B: Explicit JDBC Parameters:
# DB_URL=jdbc:mysql://gateway01.us-west-2.prod.aws.tidbcloud.com:4000/campusfix?sslMode=VERIFY_IDENTITY
# DB_USERNAME=your_username
# DB_PASSWORD=your_password
DB_URL=jdbc:mysql://localhost:3306/campusfix
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Hibernate Schema Management (update for local dev, update/validate for production)
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# JWT Configuration (REQUIRED in production: min 32 chars / 256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_256_bit_production_secret_key_minimum_32_characters_here
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration (comma-separated allowed origins, e.g. deployed Vercel domain)
CORS_ALLOWED_ORIGINS=https://campusfix-phi.vercel.app,http://localhost:5173,http://localhost:3000
