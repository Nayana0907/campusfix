# ==============================================================================
# CampusFix Backend — Environment Variables Template (.env.example)
# Copy this file to .env and configure your values.
# NEVER commit production secrets or real credentials to source control.
# ==============================================================================

# Server Configuration
PORT=8080

# MySQL / TiDB Cloud Database Configuration
# Local MySQL:
# DB_URL=jdbc:mysql://localhost:3306/campusfix
#
# TiDB Cloud Serverless (Render / Cloud deployment):
# DB_URL=jdbc:mysql://gateway01.us-west-2.prod.aws.tidbcloud.com:4000/campusfix?sslMode=VERIFY_IDENTITY
# DB_USERNAME=<prefix>.root
# DB_PASSWORD=<your_tidb_password>
DB_URL=jdbc:mysql://localhost:3306/campusfix
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Hibernate Schema Management (update for local dev, validate for production)
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# JWT Configuration
# Generate a cryptographically secure 256-bit or 512-bit key for production
# (e.g., using openssl rand -hex 32 or openssl rand -base64 64)
JWT_SECRET=your_256_bit_secret_key_here
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=https://campusfix-phi.vercel.app,http://localhost:3000,http://localhost:5173
